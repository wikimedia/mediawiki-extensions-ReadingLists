{
	"name": "ReadingLists",
	"private": true,
	"scripts": {
		"api-testing": "mocha --timeout 0 --recursive tests/api-testing",
		"lint": "npm run lint:i18n && npm run lint:scripts && npm run lint:scripts:tests && npm run lint:styles",
		"lint:i18n": "banana-checker i18n/ i18n/api/",
		"lint:scripts": "eslint --cache --ignore-pattern tests/api-testing .",
		"lint:scripts:tests": "eslint --cache --no-ignore --config tests/api-testing/.eslintrc.json tests/api-testing",
		"lint:styles": "stylelint --cache -f verbose \"resources/**/*.{css,less,vue}\"",
		"minify:svg": "svgo --config=.svgo.config.js --quiet --recursive --folder ./resources/assets",
		"test": "npm run lint && npm run test:unit",
		"test:unit": "vitest run",
		"test:unit:update-snapshots": "npm run test:unit -- --update",
		"coverage": "npm run test:unit -- --coverage"
	},
	"devDependencies": {
		"@pinia/testing": "1.0.3",
		"@vitejs/plugin-vue": "6.0.10",
		"@vitest/coverage-istanbul": "5.0.5",
		"@vue/test-utils": "2.5.1",
		"@wikimedia/codex": "2.7.0",
		"@wikimedia/types-wikimedia": "0.7.0",
		"api-testing": "1.8.1",
		"eslint-config-wikimedia": "0.32.6",
		"grunt-banana-checker": "0.13.0",
		"jsdom": "30.1.3",
		"magic-string": "0.30.21",
		"pinia": "3.0.4",
		"stylelint-config-wikimedia": "0.19.4",
		"svgo": "4.1.0",
		"typescript": "5.9.3",
		"vitest": "5.0.5",
		"vue": "3.5.43"
	}
}
