exports[`AllCollections > renders finished loading with no collections 1`] = `
<div
  class="reading-lists-all-collections"
>
  <div
    class="reading-lists-empty reading-lists-all-collections__empty-state"
  >
    <span
      class="reading-lists-empty__image"
      style="content: url("undefined/ReadingLists/resources/assets/all-collections-empty-state.svg");"
    />
    <h2
      class="reading-lists-empty__title"
    >
      You don't have any collections
    </h2>
    <!--v-if-->
    
    <button
      class="cdx-button cdx-button--action-progressive cdx-button--weight-quiet cdx-button--size-medium reading-lists-all-collections__empty-state__create-button"
    >
      
      Create collection
      
    </button>
    
  </div>
</div>
`;

